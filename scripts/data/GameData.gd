static func item(id: String) -> Dictionary:
	return ITEMS.get(id, {})


static func level(id: String) -> Dictionary:
	return LEVELS.get(id, {})


static func avatar(id: int) -> Dictionary:
	if id < 0 or id >= AVATARS.size():
		return AVATARS[1]
	return AVATARS[id]
